package {
    default_applicable_licenses: ["frameworks_base_license"],
}

// Stateless Compose rendering of an AudioStateSnapshot, shared verbatim by the SystemUI Quick
// Settings dialog and the Settings "Audio information" page. Contains no framework reads — it is a
// pure function of the snapshot data class produced by the SettingsLib audiostate repository.
android_library {
    name: "AudioStateCompose",

    srcs: ["src/**/*.kt"],
    use_resource_processor: true,
    static_libs: [
        "SettingsLib",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui-tooling-preview",
    ],
    kotlincflags: [
        "-Xjvm-default=all",
    ],
    // Inherit the platform SDK level like its SettingsLib dependency; do not pin a lower
    // min_sdk_version, or the manifest merger rejects consuming SettingsLib (higher minSdk).

    // Rendered by both the SystemUI Quick Settings dialog and the Settings app page.
    visibility: [
        "//frameworks/base/packages/SystemUI:__subpackages__",
        "//packages/apps/Settings:__subpackages__",
        "//frameworks/base/packages/SettingsLib:__subpackages__",
    ],
}
